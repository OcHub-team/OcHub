<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>ochub</string>
	<key>CFBundleIconFile</key>
	<string>ochub.icns</string>
	<!--
	  macOS 26 resolves this against Assets.car and gets the light/dark pair;
	  anything older ignores it and falls back to CFBundleIconFile above.
	-->
	<key>CFBundleIconName</key>
	<string>OcHub</string>
	<key>CFBundleIdentifier</key>
    <string>io.ochub.debug.qa</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>io.ochub.debug.qa.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>ochub</string>
            </array>
        </dict>
    </array>
    <key>CFBundleName</key>
    <string>OcHub QA</string>
    <key>CFBundleDisplayName</key>
    <string>OcHub QA</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <!--
      Keep the fixed QA bundle independent from a running production build.
      This separates the instance lock, database, and every supported tool's
      live configuration while preserving the same path between QA rebuilds.
    -->
    <key>LSEnvironment</key>
    <dict>
        <key>OCHUB_TEST_HOME</key>
        <string>/tmp/OCHUB-QA-home</string>
    </dict>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
