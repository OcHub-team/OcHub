<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresCarbon</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © OcHub contributors</string>
	<!--
	  macOS 26 resolves the app icon through this name against Assets.car,
	  which is where the light/dark pair lives (a .appiconset drops dark
	  variants outright). Older systems ignore the key and keep using the
	  .icns cargo-packager installs from `icons`.
	-->
	<key>CFBundleIconName</key>
	<string>OcHub</string>
</dict>
</plist>
