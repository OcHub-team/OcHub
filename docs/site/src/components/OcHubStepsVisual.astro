import { Icon } from "astro-icon/components";
import OcHubStepScreen from "./OcHubStepScreen.astro";

type Locale = "en" | "zh" | "ja";

interface Props {
  locale?: Locale;
  labels: string;
  visuals: string;
  app?: string;
}

const {
  locale = "en",
  labels,
  visuals,
  app = "Claude Code",
} = Astro.props;

const stepLabels = labels.split("|").map((label) => label.trim());
const stepVisuals = visuals.split("|").map((visual) => visual.trim());

if (stepLabels.length !== stepVisuals.length) {
  throw new Error(
    `OcHubStepsVisual requires equal labels and visuals (${stepLabels.length} labels, ${stepVisuals.length} visuals).`,
  );
}

