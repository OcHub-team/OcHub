    "provider-add": { path: "モデルプロバイダー → 追加", action: "再利用可能な上流プロバイダーを作成します。", done: "プロバイダーエディターが開きます。" },
    source: { path: "エディター → 接続タイプ", action: "項目入力前に直接接続またはモデルプロバイダーを選びます。", done: "選択した接続元に合う項目へ切り替わります。", note: "後から切り替えると接続元固有の値が置き換わる場合があります。" },
    identity: { path: "エディター → 名前", action: "用途、アカウント、環境を区別できる名前を付けます。", done: "プレビューと切り替えメニューに名前が表示されます。" },
    fields: { path: "エディター → 接続情報", action: "プロバイダー文書に従って API URL と認証情報を入力します。", done: "必須項目の警告が消えます。", note: "実キーを文書や共有画像へ含めないでください。" },
    tests: { path: "エディター → 確認操作", action: "URL をテストし、対応時はモデル取得や残高確認も行います。", done: "応答または検出モデルが表示されます。", note: "HTTP 応答だけではキーとモデルの有効性は確認できません。" },
    preview: { path: "エディター → 書き込むファイル", action: "展開して保存先と生成項目を一つずつ確認します。", done: "内容が対象ツールと接続目的に一致します。", note: "空のプレビューは成功ではありません。必須情報を補ってください。" },
    save: { path: "エディター上部または下部 → 保存", action: "確認とプレビューを終えてから保存します。", done: "検証エラーなく一覧へ戻り、新しい項目が表示されます。" },
    detect: { path: "プロバイダーエディター → 検出", action: "対応インターフェースとモデル一覧機能を調べます。", done: "プロトコルタグと検出結果が表示されます。" },
    model: { path: "エディター → モデル設定", action: "上流に存在するデフォルトモデルまたは制限を選びます。", done: "生成プレビューに選択モデルが表示されます。" },
    "provider-model": { path: "プロバイダーエディター → モデル", action: "初回はモデルリストを空のままにし、既定モデル、例外、思考予算は設定しません。", done: "「モデル」欄に「モデルを制限しない」と表示されます。" },
    "provider-card": { path: "接続一覧 → カード", action: "カードメニューから編集、コピー、並べ替え、削除を行います。", done: "意図したカードだけに操作が適用されます。", note: "「削除」は元に戻せません。「ツールから削除」は OcHub データを残します。" },
    "provider-switch": { path: "接続カード → 切り替え", action: "この接続をツールの実設定にします。", done: "カードが「現在」になり、対象ファイルが更新されます。" },
    "station-card": { path: "モデルプロバイダー → プロバイダーカード", action: "カードのオン／オフ、インターフェースタグ、モデル概要を確認し、変更は「編集」から行います。", done: "カード内容が保存した設定と一致します。", note: "「削除」は元に戻せません。アプリが使用中のプロバイダーは削除できず、ダイアログに対象アプリが表示されます。" },
    "station-switch": { path: "アプリ画面 → モデルプロバイダーモード", action: "対象アプリ画面を開き、「モデルプロバイダーモード」でそのプロバイダーの「切り替え」を選びます。", done: "プロバイダーに「使用中」が表示され、アプリ設定がローカルゲートウェイを指します。" },
    welcome: { path: "初回起動 → ようこそ", action: "検出されたツールを確認し、開始方法を選びます。", done: "インポートまたはメイン画面へ進みます。" },
    import: { path: "初回起動 → インポート", action: "既存設定を取り込み、手作業での再作成を避けます。", done: "取り込んだ項目が確認一覧に表示されます。" },
    "apps-settings": { path: "設定 → アプリとプラグイン", action: "表示または管理対象にするアプリだけを有効にします。", done: "サイドバーと対象アプリの状態が運用に一致します。", note: "少なくとも 1 アプリを有効にします。" },
    "mcp-import": { path: "MCP サーバー → インポート／同期", action: "既存サーバーを検出し、対象を確認して同期します。", done: "有効な各アプリで同期成功が表示されます。" },
    "skill-search": { path: "スキル → 探す", action: "用途で検索するか、リポジトリを参照します。", done: "結果カードに提供元と対象アプリが表示されます。" },
    pricing: { path: "使用量 → モデル価格", action: "ログのモデル ID を合わせ、カタログ不足時だけ上書きします。", done: "リクエスト詳細に意図した課金モデルとコストが表示されます。" },
    "session-list": { path: "セッション → フィルターとカード", action: "アプリと期間を選び、対象の会話を開きます。", done: "タイトル、件数、期間が対象セッションと一致します。" },
    "usage-summary": { path: "使用量 → サマリー", action: "比較前に 4 指標が同じ範囲を使っているか確認します。", done: "コスト、件数、トークン、キャッシュの範囲が一致します。" },
    "usage-filter": { path: "使用量 → フィルター／統計", action: "期間、Provider、モデル、状態で段階的に絞ります。", done: "グラフ、表、ログが同じ条件へ更新されます。" },
    "request-detail": { path: "使用量またはセッション → 詳細", action: "モデル、トークン、コスト、状態、遅延をまとめて確認します。", done: "選択した集計または会話項目を説明できる情報が表示されます。" },
    "theme-mode": { path: "テーマ → 表示モード", action: "システム、ライト、ダークの動作を選びます。", done: "プレビューが目的の外観へ変わります。" },
    "theme-card": { path: "テーマ → テーマカード", action: "ライト／ダークを確認してから適用します。", done: "アプリ全体が選択テーマへ変わります。" },
    sync: { path: "データとバックアップ → リモート同期", action: "テスト、保存、アップロードの順に実行します。", done: "最終同期時刻がエラーなしで更新されます。", note: "接続テストは入力項目を保存しません。" },
    restore: { path: "データとバックアップ → 復元", action: "スナップショットを確認し、ローカル置換を確定します。", done: "安全バックアップ作成後に復元が完了します。", note: "復元前に他端末での編集を止めます。" },
    result: { path: "操作結果", action: "生成されたカード、状態、データを確認します。", done: "目的の内容がエラーなく表示されます。" },
  },
};

const guideAliases: Record<string, string> = {
  "provider-fields": "fields",
  "model-provider-card": "station-card",
  "model-provider-switch": "station-switch",
  "connection-card": "provider-card",
  "connection-add": "provider-switch",
  "connection-switch": "provider-switch",
  "connection-copy": "provider-card",
  "connection-remove": "provider-card",
  "mcp-add": "toolbar-add",
  "mcp-fields": "fields",
  "mcp-targets": "apps-settings",
  "mcp-save": "save",
  "mcp-sync": "mcp-import",
  "mcp-result": "result",
  "skill-targets": "apps-settings",
  "skill-install": "save",
  "skill-result": "result",
  "session-detail": "request-detail",
  "pricing-save": "save",
  "backup-create": "save",
  "backup-result": "result",
  "backup-restore": "restore",
  "sync-fields": "fields",
  "sync-test": "tests",
  "sync-save": "save",
  "sync-upload": "sync",
  "sync-status": "sync",
  "sync-stop": "result",
  "sync-restore": "restore",
  "sync-result": "result",
};

const guideFor = (visual: string): Guide =>
  guides[locale][visual] ??
  guides[locale][guideAliases[visual]] ??
  guides[locale].result ??
  guides.en.result;
---

<figure class="steps-visual" aria-label={t.figure}>
  <div class="steps-heading">
    <Icon name="ph:cursor-click" />
    <strong>{t.figure}</strong>
    <span>{t.caption}</span>
  </div>

  <div class="steps-grid">
    {stepLabels.map((label, index) => {
      const visual = stepVisuals[index];
      const guide = guideFor(visual);
      return (
        <section class="step-panel">
          <header>
            <span>{index + 1}</span>
            <div>
              <small>STEP {String(index + 1).padStart(2, "0")}</small>
              <strong>{label}</strong>
            </div>
          </header>

          <div class="step-layout">
            <aside class="step-guide">
              <dl>
                <div>
                  <dt><Icon name="ph:map-pin" />{t.path}</dt>
                  <dd>{guide.path}</dd>
                </div>
                <div>
                  <dt><Icon name="ph:cursor-click" />{t.action}</dt>
                  <dd>{guide.action}</dd>
                </div>
                <div>
                  <dt><Icon name="ph:check-circle" />{t.done}</dt>
                  <dd>{guide.done}</dd>
                </div>
                {guide.note && (
                  <div class="is-note">
                    <dt><Icon name="ph:warning" />{t.note}</dt>
                    <dd>{guide.note}</dd>
                  </div>
                )}
              </dl>
            </aside>

            <div class:list={["step-scene", `is-${visual}`]} aria-hidden="true">
              <OcHubStepScreen locale={locale} visual={visual} app={app} />
              {false && (<div class="legacy-scene">
              <div class="scene-bar"><i></i><i></i><i></i><span>OcHub</span></div>

            {is(visual, "sidebar-app", "provider-nav", "mcp-nav", "skills-nav", "sessions-nav", "usage-nav", "settings-nav", "theme-nav") ? (
              <div class="scene-shell">
                <aside>
                  <small>{is(visual, "provider-nav") ? t.providers : t.apps}</small>
                  <b class:list={{ target: is(visual, "sidebar-app") }}>
                    <Icon name="ph:robot" /> {app}
                  </b>
                  <b class:list={{ target: is(visual, "provider-nav") }}>
                    <Icon name="ph:cloud" /> {t.providers}
                  </b>
                  <b class:list={{ target: is(visual, "mcp-nav") }}>
                    <Icon name="ph:squares-four" /> MCP
                  </b>
                  <b class:list={{ target: is(visual, "skills-nav") }}>
                    <Icon name="ph:pencil-simple" /> Skills
                  </b>
                  <b class:list={{ target: is(visual, "sessions-nav") }}>
                    <Icon name="ph:chats-circle" /> {t.sessions}
                  </b>
                  <b class:list={{ target: is(visual, "usage-nav") }}>
                    <Icon name="ph:chart-bar" /> {t.usage}
                  </b>
                  <b class:list={{ target: is(visual, "settings-nav") }}>
                    <Icon name="ph:gear-six" /> {t.settings}
                  </b>
                  <b class:list={{ target: is(visual, "theme-nav") }}>
                    <Icon name="ph:palette" /> {t.theme}
                  </b>
                </aside>
                <main><i></i><i></i><i></i></main>
              </div>
            ) : is(visual, "toolbar-add", "provider-add", "save") ? (
              <div class="scene-toolbar">
                <div><strong>{is(visual, "provider-add") ? t.providers : app}</strong><span></span></div>
                <b class:list={{ target: visual !== "save" }}>
                  <Icon name="ph:plus" /> {is(visual, "provider-add") ? t.addProvider : t.add}
                </b>
                <b class:list={{ target: visual === "save" }}>{t.save}</b>
              </div>
            ) : visual === "source" ? (
              <div class="scene-form">
                <small>{t.direct}</small>
                <div class="scene-segment target"><b>{t.direct}</b><span>{t.shared}</span></div>
                <label>{t.name}<i></i></label>
              </div>
            ) : is(visual, "identity", "fields") ? (
              <div class="scene-form">
                <label class:list={{ target: visual === "identity" }}>{t.name}<i></i></label>
                <label class:list={{ target: visual === "fields" }}>{t.endpoint}<i>https://api.example.com</i></label>
                <label class:list={{ target: visual === "fields" }}>{t.key}<i>••••••••••••</i></label>
              </div>
            ) : visual === "tests" ? (
              <div class="scene-form">
                <label>{t.endpoint}<i>https://api.example.com</i></label>
                <div class="scene-actions target"><b>{t.test}</b><b>{t.models}</b><b>{t.balance}</b></div>
              </div>
            ) : visual === "preview" ? (
              <div class="scene-preview">
                <div><label>{t.name}<i></i></label><label>{t.endpoint}<i></i></label></div>
                <aside class="target"><strong>{t.files}</strong><span>settings.json</span><pre>{`{\n  "env": {…}\n}`}</pre></aside>
              </div>
            ) : visual === "detect" ? (
              <div class="scene-form">
                <label>{t.endpoint}<i>https://api.example.com</i></label>
                <div class="scene-actions target"><b>{t.test}</b><b>{t.detect}</b><b>{t.models}</b></div>
                <div class="scene-chips"><span>Anthropic</span><span>Responses</span><span>Chat</span></div>
              </div>
            ) : visual === "model" ? (
              <div class="scene-form">
                <div class="scene-chips"><span>Anthropic</span><span>Responses</span></div>
                <label class="target">{t.defaultModel}<i>—</i></label>
                <label><span></span><i></i></label>
              </div>
            ) : visual === "provider-card" ? (
              <div class="scene-card target">
                <Icon name="ph:stack" />
                <div><strong>Demo</strong><span>Anthropic · Responses · Chat</span></div>
                <i></i>
              </div>
            ) : visual === "provider-switch" ? (
              <div class="scene-card">
                <Icon name="ph:stack" />
                <div><strong>Demo</strong><span>{t.current}</span></div>
                <b class="target">{t.switch}</b>
              </div>
            ) : is(visual, "welcome", "import", "apps-settings") ? (
              <div class="scene-dialog">
                <strong>{visual === "apps-settings" ? t.appSettings : t.welcome}</strong>
                <p></p><p></p>
                {visual === "apps-settings" ? (
                  <div class="scene-list target"><span>Claude Code</span><i></i><span>Codex</span><i></i></div>
                ) : (
                  <div class:list={["scene-actions", { target: visual === "import" }]}>
                    <b>{t.continue}</b><b>Skip</b>
                  </div>
                )}
              </div>
            ) : visual === "mcp-import" ? (
              <div class="scene-dialog">
                <strong>MCP</strong><p></p>
                <div class="scene-actions target"><b>{t.import}</b><b>JSON</b></div>
                <div class="scene-list"><span>filesystem</span><i></i></div>
              </div>
            ) : visual === "skill-search" ? (
              <div class="scene-form">
                <label class="target">{t.search}<i>Search…</i></label>
                <div class="scene-card"><Icon name="ph:pencil-simple" /><div><strong>Example skill</strong><span>Repository</span></div></div>
              </div>
            ) : visual === "pricing" ? (
              <div class="scene-form">
                <strong>{t.price}</strong>
                <label class="target">Model ID<i>model-name</i></label>
                <div class="scene-prices target"><i>$ 0.00</i><i>$ 0.00</i><i>$ 0.00</i><i>$ 0.00</i></div>
              </div>
            ) : visual === "session-list" ? (
              <div class="scene-data">
                <div class="scene-filter target"><b>{app}</b><b>{t.range}</b></div>
                <div class="scene-row target"><i></i><span><strong>Refactor API client</strong><small>12 messages · 10:42</small></span><b>{t.view}</b></div>
                <div class="scene-row"><i></i><span><strong>Update documentation</strong><small>8 messages · 09:18</small></span></div>
              </div>
            ) : visual === "usage-summary" ? (
              <div class="scene-data">
                <div class="scene-filter"><b>{t.range}</b><b>{t.filter}</b></div>
                <div class="scene-metrics target">
                  <span><small>{t.cost}</small><strong>$12.48</strong></span>
                  <span><small>{t.requests}</small><strong>248</strong></span>
                  <span><small>{t.tokens}</small><strong>1.2M</strong></span>
                </div>
                <div class="scene-chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
              </div>
            ) : visual === "usage-filter" ? (
              <div class="scene-data">
                <div class="scene-filter target"><b>{t.range}</b><b>Provider</b><b>Model</b></div>
                <div class="scene-row target"><i></i><span><strong>Anthropic</strong><small>claude-sonnet · 87%</small></span><b>142</b></div>
                <div class="scene-row"><i></i><span><strong>OpenAI</strong><small>gpt-5 · 13%</small></span><b>21</b></div>
              </div>
            ) : visual === "request-detail" ? (
              <div class="scene-detail target">
                <strong>claude-sonnet-4</strong>
                <div><span>{t.tokens}<b>8,420 → 1,206</b></span><span>{t.cost}<b>$0.084</b></span></div>
                <div><span>TTFT<b>620 ms</b></span><span>Status<b>200</b></span></div>
                <pre>request_id  req_••••••</pre>
              </div>
            ) : visual === "theme-mode" ? (
              <div class="scene-theme">
                <strong>{t.theme}</strong>
                <div class="scene-segment target"><b>{t.system}</b><span>{t.light}</span><span>{t.dark}</span></div>
                <div class="theme-preview"></div>
              </div>
            ) : visual === "theme-card" ? (
              <div class="scene-theme">
                <strong>{t.theme}</strong>
                <div class="theme-card target"><div><i></i><i></i><i></i></div><span><b>OcHub</b><small>Light · Dark</small></span><button>{t.apply}</button></div>
              </div>
            ) : visual === "sync" ? (
              <div class="scene-form">
                <label>WebDAV / S3<i>https://sync.example.com</i></label>
                <div class="scene-actions target"><b>{t.test}</b><b>{t.save}</b><b>{t.upload}</b></div>
                <div class="scene-card"><Icon name="ph:cloud-check" /><div><strong>2026-07-29 10:42</strong><span>{t.preview}</span></div></div>
              </div>
            ) : visual === "restore" ? (
              <div class="scene-dialog target">
                <strong>{t.restore}</strong><p></p><p></p>
                <div class="scene-actions"><b>{t.restore}</b><b>Cancel</b></div>
              </div>
            ) : (
              <div class="scene-generic">
                <Icon name="ph:check-circle" />
                <strong>{label}</strong>
                <span>{t.preview}</span>
              </div>
            )}
              </div>)}
            </div>
          </div>
        </section>
      );
    })}
  </div>
</figure>

<style>
  .steps-visual {
    width: min(50rem, calc(100vw - 2rem));
    margin: 1.5rem 0 2rem 50%;
    padding: 1rem;
    color: var(--nb-foreground);
    background: var(--nb-card);
    border: 1px solid var(--nb-border);
    border-radius: 0.85rem;
    box-shadow: var(--nb-shadow);
    transform: translateX(-50%);
  }

  .steps-heading {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .steps-heading :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--nb-primary);
  }

  .steps-heading strong {
    font-size: 0.82rem;
  }

  .steps-heading span {
    color: var(--nb-muted-foreground);
    font-size: 0.72rem;
    text-align: right;
  }

  .steps-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .step-panel {
    overflow: hidden;
    background: var(--nb-background);
    border: 1px solid var(--nb-border);
    border-radius: 0.75rem;
  }

  .step-panel > header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.5rem;
    padding: 0.6rem 0.75rem;
    background: color-mix(in srgb, var(--nb-muted) 60%, var(--nb-card));
    border-bottom: 1px solid var(--nb-border);
  }

  .step-panel > header span {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex: none;
    align-items: center;
    justify-content: center;
    color: var(--nb-primary-foreground);
    background: var(--nb-primary);
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 750;
  }

  .step-panel > header div {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .step-panel > header small {
    color: var(--nb-muted-foreground);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .step-panel > header strong {
    font-size: 0.9rem;
  }

  .step-layout {
    display: flex;
    flex-direction: column;
  }

  .step-guide {
    order: 2;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--nb-panel) 64%, var(--nb-background));
    border-top: 1px solid var(--nb-border);
  }

  .step-guide dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0;
  }

  .step-guide dl > div {
    padding-right: 0.8rem;
    border-right: 1px solid color-mix(in srgb, var(--nb-border) 70%, transparent);
  }

  .step-guide dl > div:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .step-guide dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.22rem;
    color: var(--nb-primary);
    font-size: 0.62rem;
    font-weight: 750;
  }

  .step-guide dt :global(svg) {
    width: 0.78rem;
    height: 0.78rem;
  }

  .step-guide dd {
    margin: 0;
    color: var(--nb-foreground);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .step-guide .is-note {
    grid-column: 1 / -1;
