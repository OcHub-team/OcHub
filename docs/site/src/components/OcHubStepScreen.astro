---
import { Icon } from "astro-icon/components";

type Locale = "en" | "zh" | "ja";

interface Props {
  locale?: Locale;
  visual: string;
  app?: string;
}

const { locale = "en", visual, app = "Claude Code" } = Astro.props;

const copy = {
  en: {
    apps: "Apps", tools: "Tools", network: "Network", system: "System",
    providers: "Model providers", mcp: "MCP servers", skills: "Skills",
    sessions: "Sessions", usage: "Usage", settings: "Settings", theme: "Theme",
    advanced: "Advanced tools", about: "About", appSettings: "App settings",
    add: "Add connection", save: "Save", cancel: "Cancel", direct: "Direct connection",
    shared: "Model provider", name: "Name", endpoint: "Base URL", key: "API key",
    tests: "Connection checks", test: "Test URL", models: "Fetch models",
    balance: "Check balance", files: "Files to be written", current: "Current",
    switch: "Switch", import: "Import from app", sync: "Sync to apps",
    discover: "Discover", installed: "Installed", search: "Search skills",
    range: "Last 7 days", filter: "All apps", view: "View", messages: "messages",
    totalCost: "Total cost", requests: "Total requests", tokens: "Actual tokens",
    cache: "Cache hit rate", general: "General", appsPlugins: "Apps and plugins",
    display: "Display mode", systemMode: "Follow system", light: "Always light",
    dark: "Always dark", apply: "Apply", remote: "Remote sync",
    data: "Data and backups",
    upload: "Upload local snapshot", restore: "Restore", success: "Completed",
    addProvider: "Add model provider", detect: "Detect", pricing: "Model pricing",
    otherTools: "Connect other tools", importExisting: "Import from an existing config",
    endpointTest: "HTTP latency test", apiAddress: "API address",
    endpointNumber: "API address 1", websiteOptional: "Website (optional)",
    modelsLabel: "Models", modelsUnrestricted: "Any model",
    modelsConfigured: "39 models configured",
    edit: "Edit", duplicate: "Copy", remove: "Delete",
    defaultModel: "Default model",
    connectionId: "Connection ID (optional)", websiteUrl: "Website URL", category: "Category",
    relayMode: "Model provider mode",
    relayModeHint: "Pick a model provider to route this app through.",
    manageProviders: "Manage model providers",
    copyToApp: "Copy to app", errorCount: "1 error", warningCount: "1 warning",
  },
  zh: {
    apps: "应用", tools: "工具", network: "网络", system: "系统",
    providers: "模型供应商", mcp: "MCP 服务器", skills: "技能",
    sessions: "会话", usage: "用量", settings: "设置", theme: "主题",
    advanced: "高级工具", about: "关于", appSettings: "应用设置",
    add: "添加连接", save: "保存", cancel: "取消", direct: "直接连接",
    shared: "模型供应商", name: "名称", endpoint: "Base URL", key: "API Key",
    tests: "连接检查", test: "测试 URL", models: "拉取模型",
    balance: "查询余额", files: "将写入的文件", current: "当前",
    switch: "切换", import: "从应用导入", sync: "同步到应用",
    discover: "发现", installed: "已安装", search: "搜索技能",
    range: "最近 7 天", filter: "全部应用", view: "查看", messages: "条消息",
    totalCost: "总成本", requests: "总请求数", tokens: "真实 Token",
    cache: "缓存命中", general: "通用", appsPlugins: "应用与插件",
    display: "显示模式", systemMode: "跟随系统", light: "固定浅色",
    dark: "固定深色", apply: "应用", remote: "远端同步",
    data: "数据与备份",
    upload: "上传本地快照", restore: "恢复", success: "操作完成",
    addProvider: "添加模型供应商", detect: "检测", pricing: "模型定价",
    otherTools: "其他工具接入", importExisting: "从现有配置导入",
    endpointTest: "HTTP 延迟测试", apiAddress: "API 地址",
    endpointNumber: "API 地址 1", websiteOptional: "官网（可选）",
    modelsLabel: "模型", modelsUnrestricted: "不限制模型",
    modelsConfigured: "已配置 39 个模型",
    edit: "编辑", duplicate: "复制", remove: "删除",
    defaultModel: "默认模型",
    connectionId: "连接 ID（可选）", websiteUrl: "网站 URL", category: "分类",
    relayMode: "模型供应商模式",
    relayModeHint: "选择一个模型供应商，本应用的请求将经它转发。",
    manageProviders: "管理模型供应商",
    copyToApp: "复制到应用", errorCount: "1 个错误", warningCount: "1 个警告",
  },
  ja: {
    apps: "アプリ", tools: "ツール", network: "ネットワーク", system: "システム",
    providers: "モデルプロバイダー", mcp: "MCP サーバー", skills: "スキル",
    sessions: "セッション", usage: "使用量", settings: "設定", theme: "テーマ",
    advanced: "高度なツール", about: "情報", appSettings: "アプリ設定",
    add: "接続を追加", save: "保存", cancel: "キャンセル", direct: "直接接続",
    shared: "モデルプロバイダー", name: "名前", endpoint: "Base URL", key: "API キー",
    tests: "接続確認", test: "URL をテスト", models: "モデルを取得",
    balance: "残高を確認", files: "書き込むファイル", current: "現在",
    switch: "切り替え", import: "アプリからインポート", sync: "アプリへ同期",
    discover: "探す", installed: "インストール済み", search: "スキルを検索",
    range: "過去 7 日", filter: "すべてのアプリ", view: "表示", messages: "件",
    totalCost: "総コスト", requests: "総リクエスト", tokens: "実トークン",
    cache: "キャッシュヒット", general: "一般", appsPlugins: "アプリとプラグイン",
    display: "表示モード", systemMode: "システムに従う", light: "常にライト",
    dark: "常にダーク", apply: "適用", remote: "リモート同期",
    data: "データとバックアップ",
    upload: "ローカルをアップロード", restore: "復元", success: "完了",
    addProvider: "モデルプロバイダーを追加", detect: "検出", pricing: "モデル価格",
    otherTools: "他のツールから接続", importExisting: "既存の設定からインポート",
    endpointTest: "HTTP 遅延テスト", apiAddress: "API アドレス",
    endpointNumber: "API アドレス 1", websiteOptional: "公式サイト（任意）",
    modelsLabel: "モデル", modelsUnrestricted: "モデルを制限しない",
    modelsConfigured: "設定済みモデル 39 件",
    edit: "編集", duplicate: "コピー", remove: "削除",
    defaultModel: "デフォルトモデル",
    connectionId: "接続 ID（任意）", websiteUrl: "Web サイト URL", category: "カテゴリー",
    relayMode: "モデルプロバイダーモード",
    relayModeHint: "モデルプロバイダーを選ぶと、このアプリのリクエストがそこを経由します。",
    manageProviders: "モデルプロバイダーを管理",
    copyToApp: "アプリにコピー", errorCount: "エラー 1 件", warningCount: "警告 1 件",
  },
} satisfies Record<Locale, Record<string, string>>;

const t = copy[locale];
const is = (...names: string[]) => names.includes(visual);
const connectionEditing = is("source", "identity", "fields", "tests", "preview", "save", "model");

// Sample model shown in the connection editor's default-model field, matched
// to the app the walkthrough is about.
const editorSampleModel =
  app === "Codex" ? "gpt-5-codex" : app === "Grok Build" ? "grok-4.5" : "claude-sonnet-4-6";

const page =
  is("provider-nav", "provider-add", "provider-fields", "detect", "provider-model", "model-provider-card") ? "providers" :
  is("mcp-nav", "mcp-import", "mcp-add", "mcp-fields", "mcp-targets", "mcp-save", "mcp-sync", "mcp-result") ? "mcp" :
  is("skills-nav", "skill-search", "skill-targets", "skill-install", "skill-result") ? "skills" :
  is("sessions-nav", "session-list", "session-detail") ? "sessions" :
  is("usage-nav", "usage-summary", "usage-filter", "request-detail", "pricing", "pricing-save") ? "usage" :
  is("theme-nav", "theme-mode", "theme-card") ? "theme" :
  is("settings-nav", "apps-settings") ? "settings" :
  is("sync", "restore", "backup-create", "backup-result", "backup-restore", "sync-fields", "sync-test", "sync-save", "sync-upload", "sync-status", "sync-stop", "sync-restore", "sync-result") ? "sync" : "connections";

const pageTitle =
  page === "providers" ? t.providers :
  page === "mcp" ? t.mcp :
  page === "skills" ? t.skills :
  page === "sessions" ? t.sessions :
  page === "usage" ? t.usage :
  page === "theme" ? t.theme :
  page === "settings" ? t.settings :
  page === "sync" ? t.settings : app;

const navTarget = (name: string) =>
  (name === "app" && visual === "sidebar-app") ||
  (name === "providers" && visual === "provider-nav") ||
  (name === "mcp" && visual === "mcp-nav") ||
  (name === "skills" && visual === "skills-nav") ||
  (name === "sessions" && visual === "sessions-nav") ||
  (name === "usage" && visual === "usage-nav") ||
  (name === "settings" && visual === "settings-nav") ||
  (name === "theme" && visual === "theme-nav");
---

<div class="full-screen" aria-hidden="true">
  <div class="window-bar">
    <i></i><i></i><i></i>
    <b><Icon name="ph:desktop" /></b>
  </div>

  <div class="app-shell">
    <aside class="sidebar">
      <small>{t.apps}</small>
      <b class:list={{ target: navTarget("app"), selected: page === "connections" }}>
        <Icon name="ph:robot" />{app}
      </b>
      <b><Icon name="ph:sparkle" />Claude Desktop</b>
      <b><Icon name="ph:terminal-window" />Codex</b>
      <b><Icon name="ph:circle-notch" />Grok Build</b>
      <b><Icon name="ph:square" />OpenCode</b>
      <small>{t.network}</small>
      <b class:list={{ target: navTarget("providers"), selected: page === "providers" }}>
        <Icon name="ph:cloud" />{t.providers}
      </b>
      <small>{t.tools}</small>
      <b class:list={{ target: navTarget("mcp"), selected: page === "mcp" }}>
        <Icon name="ph:squares-four" />{t.mcp}
      </b>
      <b class:list={{ target: navTarget("skills"), selected: page === "skills" }}>
        <Icon name="ph:pencil-simple" />{t.skills}
      </b>
      <b class:list={{ target: navTarget("sessions"), selected: page === "sessions" }}>
        <Icon name="ph:chats-circle" />{t.sessions}
      </b>
      <b class:list={{ target: navTarget("usage"), selected: page === "usage" }}>
        <Icon name="ph:chart-bar" />{t.usage}
      </b>
      <b><Icon name="ph:wrench" />{t.advanced}</b>
      <small>{t.system}</small>
      <b class:list={{ target: navTarget("settings"), selected: page === "settings" || page === "sync" }}>
        <Icon name="ph:gear-six" />{t.settings}
      </b>
      <b class:list={{ target: navTarget("theme"), selected: page === "theme" }}>
        <Icon name="ph:palette" />{t.theme}
      </b>
      <b><Icon name="ph:info" />{t.about}</b>
    </aside>

    <main class="workspace">
      <header class="page-header">
        <div><strong>{connectionEditing ? t.add : pageTitle}</strong><span>{connectionEditing ? `${t.apps}: ${app}` : page === "connections" ? `${t.current} · ${t.direct}` : "OcHub"}</span></div>
        {connectionEditing && <><em>{t.errorCount}</em><em>{t.warningCount}</em><button>{t.copyToApp}</button><button class:list={["primary", { target: is("save") }]}>{t.save}</button><button>{t.cancel}</button></>}
        {page === "providers" && <><button>{t.otherTools}</button><button>{t.importExisting}</button></>}
        {!connectionEditing && (page === "connections" || page === "providers") && (
          <button class:list={{ target: is("toolbar-add", "provider-add") }}>
            <Icon name="ph:plus" />{page === "providers" ? t.addProvider : t.add}
          </button>
        )}
        {!connectionEditing && page === "connections" && <button><Icon name="ph:gear-six" />{t.appSettings}</button>}
      </header>

      {page === "connections" && (
        connectionEditing ? (
          <div class="editor-grid">
            <section class="form-pane">
              <small>{t.direct}</small>
              <div class:list={["segmented", { target: is("source") }]}>
                <b>{t.direct}</b><span>{t.shared}</span>
              </div>
              <label class:list={{ target: is("identity") }}>{t.name}<i>Work account</i></label>
              <label>{t.connectionId}<i>work-account</i></label>
              <div class="two-fields"><label>{t.websiteUrl}<i>https://example.com</i></label><label>{t.category}<i>third_party</i></label></div>
              <label class:list={{ target: is("fields") }}>{t.endpoint}<i>https://api.example.com</i></label>
              <label class:list={{ target: is("fields") }}>{t.key}<i>••••••••••••••••</i></label>
              <label class:list={{ target: is("model") }}>{t.defaultModel}<i>{editorSampleModel}</i></label>
              <div class:list={["actions", { target: is("tests") }]}>
                <button>{t.test}</button><button>{t.models}</button><button>{t.balance}</button>
              </div>
            </section>
            <aside class:list={["file-preview", { target: is("preview") }]}>
              <strong>{t.files}</strong><small>~/.claude/settings.json</small>
              <div class="tabs"><b>JSON</b><span>{t.edit}</span></div>
              <pre>{`{\n  "env": {\n    "ANTHROPIC_BASE_URL":\n      "https://api.example.com"\n  }\n}`}</pre>
            </aside>
          </div>
        ) : visual === "model-provider-switch" ? (
          <div class="connection-list">
            <div class="relay-panel">
              <div class="relay-panel-head">
                <span class="avatar"><Icon name="ph:stack" /></span>
                <div><strong>{t.relayMode}</strong><small>{t.relayModeHint}</small></div>
                <button>{t.manageProviders}</button>
              </div>
              <div class="relay-row">
                <strong>Krill</strong>
                <button class="primary target">{t.switch}</button>
              </div>
            </div>
            <strong class="section-label">{t.direct}</strong>
            <div class="connection-card"><i class="drag-dots">⋮</i><span class="avatar"><Icon name="ph:robot" /></span><div><strong>Work account</strong><small>https://api.example.com</small></div><button>{t.edit}</button><button>{t.duplicate}</button><button>{t.remove}</button><button class="primary">{t.switch}</button></div>
          </div>
        ) : (
          <div class="connection-list">
            <div class="current-label">{t.current} · {t.direct}</div>
            <div class:list={["connection-card current-card", { target: is("connection-card") }]}>
              <span class="avatar"><Icon name="ph:robot" /></span>
              <div><small>{t.current} · {t.direct}</small><strong>Claude-Blank</strong></div>
              <button>{t.edit}</button>
            </div>
            <strong class="section-label">{t.direct}</strong>
            <div class:list={["connection-card", { target: is("connection-add", "connection-switch", "connection-copy", "connection-remove") }]}>
              <i class="drag-dots">⋮</i><span class="avatar"><Icon name="ph:robot" /></span>
              <div><strong>Work account</strong><small>https://api.example.com</small></div>
              <button>{t.edit}</button><button class:list={{ target: is("connection-copy") }}>{t.duplicate}</button><button class:list={{ target: is("connection-remove") }}>{t.remove}</button><button class:list={["primary", { target: is("connection-add", "connection-switch") }]}>{t.switch}</button>
            </div>
            <div class="connection-card"><i class="drag-dots">⋮</i><span class="avatar"><Icon name="ph:robot" /></span><div><strong>Backup</strong><small>https://backup.example.com</small></div><button>{t.edit}</button><button>{t.duplicate}</button><button>{t.remove}</button><button class="primary">{t.switch}</button></div>
          </div>
        )
      )}

      {page === "providers" && (
        is("provider-fields", "detect", "provider-model") ? (
          <div class="provider-editor">
            <div class="form-section-header"><strong>{t.addProvider}</strong><span><button>{t.cancel} Esc</button><button class="primary">{t.save} ⌘S</button></span></div>
            <div class:list={["provider-top-fields", { target: is("provider-fields") }]}>
              <label>{t.name}<i>Krill</i></label>
              <label>{t.websiteOptional}<i>https://example.com</i></label>
              <label>{t.key}<i>••••••••••••</i></label>
            </div>
            <section>
              <strong>{t.endpointNumber}</strong>
              <label>{t.apiAddress}<i>https://api.example.com</i></label>
              <div class:list={["actions", { target: is("detect") }]}><button>{t.endpointTest}</button><button>{t.detect}</button><button>{t.models}</button></div>
              <p class="helper-line"></p>
              <div class="chips"><b>Anthropic Messages</b><b>OpenAI Responses</b><b>OpenAI Chat</b></div>
              <label class:list={{ target: is("provider-model") }}>{t.modelsLabel}<i>{t.modelsUnrestricted}</i></label>
            </section>
          </div>
        ) : (
          <div class="provider-list">
            <div class:list={["provider-item", { target: is("model-provider-card") }]}>
              <span class="avatar"><Icon name="ph:stack" /></span><div><strong>Krill</strong><span class="chips"><b>Anthropic Messages</b><b>OpenAI Responses</b><b>OpenAI Chat</b></span><small>https://api.example.com · {t.modelsConfigured}</small></div><i class="switch-control"></i><button>{t.edit}</button><button>{t.remove}</button>
            </div>
          </div>
        )
      )}

      {page === "mcp" && (
        is("mcp-add", "mcp-fields", "mcp-targets", "mcp-save") ? (
          <div class="mcp-editor">
            <button class:list={{ target: is("mcp-add") }}>← Back</button>
            <label class:list={{ target: is("mcp-fields") }}>{t.name}<i>filesystem</i></label>
            <label>Description<i>Local filesystem access</i></label>
            <div class:list={["mcp-targets", { target: is("mcp-targets") }]}><span>Claude Code<i></i></span><span>Codex<i></i></span><span>Grok Build<i></i></span><span>OpenCode<i></i></span></div>
            <label class:list={{ target: is("mcp-fields") }}>Server JSON<pre>{`{\n  "type": "stdio",\n  "command": "npx",\n  "args": ["-y", "server"]\n}`}</pre></label>
            <div class="actions"><button class:list={["primary", { target: is("mcp-save") }]}>{t.save}</button><button>{t.cancel}</button></div>
          </div>
        ) : (
          <div class="catalog-page">
            <div class="toolbar-row">
              <button class:list={{ target: is("mcp-add") }}><Icon name="ph:plus" />Add</button>
              <button class:list={{ target: is("mcp-import") }}>{t.import}</button>
              <button class:list={{ target: is("mcp-sync") }}>{t.sync}</button>
            </div>
            <div class:list={["catalog-card mcp-card", { target: is("mcp-import", "mcp-result") }]}>
              <div><strong>@modelcontextprotocol/server-memory</strong><small>npx -y @modelcontextprotocol/server-memory</small><small>Apps · Claude Code, Codex</small></div><button>Edit</button><button>Delete</button>
              <div class="mcp-card-targets"><span>Claude Code<i></i></span><span>Codex<i></i></span><span>Grok Build<i></i></span><span>OpenCode<i></i></span></div>
            </div>
            <div class:list={["catalog-card mcp-card", { target: is("mcp-sync") }]}><div><strong>filesystem</strong><small>npx -y server-filesystem</small><small>Apps · OpenCode</small></div><button>Edit</button><button>Delete</button><div class="mcp-card-targets"><span>Claude Code<i></i></span><span>Codex<i></i></span><span>OpenCode<i></i></span></div></div>
          </div>
        )
      )}

      {page === "skills" && (
        <div class="catalog-page">
          <div class="tabs-line"><b>{t.installed} (36)</b><span>{t.discover}</span></div>
          {is("skill-search", "skill-targets", "skill-install", "skill-result") ? (
            <>
              <div class="skills-discover-row"><div class="tabs-line"><b>Marketplace</b><span>Repository</span></div><div class:list={["segmented three", { target: is("skill-targets") }]}><b>Claude Code</b><span>Codex</span><span>OpenCode</span></div></div>
              <label class:list={["search-field", { target: is("skill-search") }]}><Icon name="ph:magnifying-glass" /><span>{t.search}</span><button>Search</button></label>
              <div class:list={["catalog-card", { target: is("skill-install", "skill-result") }]}><span class="avatar"><Icon name="ph:file-pdf" /></span><div><strong>PDF tools</strong><small>openai/skills · Marketplace</small></div><button class="primary">Install</button></div>
            </>
          ) : (
            <>
              <div class="skill-metrics"><span><small>Installed</small><strong>36</strong></span><span><small>Remote sources</small><strong>24</strong></span><span><small>Update status</small><strong>Latest</strong></span></div>
              <label class="search-field"><Icon name="ph:magnifying-glass" /><span>Search installed skills</span><button>Check updates</button></label>
              <div class="catalog-card skill-card"><div><strong>adapt</strong><small>pbakaus/impeccable@main</small><p>Adapt designs to work across different screen sizes and contexts.</p></div><button>Repository</button><button>Directory</button><button>Uninstall</button></div>
            </>
          )}
        </div>
      )}

      {page === "sessions" && (
        <div class="data-page">
          {is("session-detail") ? (
            <div class="session-detail target"><div class="form-section-header"><span><button>← Back</button><strong>Refactor API client</strong></span><small>Claude Code · 10:42–11:08</small></div><div class="message user"><b>User</b><p>Update the API client and keep compatibility.</p></div><div class="message assistant"><b>Assistant</b><p>I inspected the current implementation and updated the request path.</p></div><div class="message tool"><b>Tool</b><pre>{`Read src/client.rs\nEdited 3 files`}</pre></div></div>
          ) : (
            <>
              <div class:list={["session-filters", { target: is("session-list") }]}><label class="search-field"><Icon name="ph:magnifying-glass" /><span>Search sessions</span></label><button>{t.range}</button><button>{t.filter}</button><button><Icon name="ph:arrows-clockwise" /></button></div>
              <div class:list={["session-card", { target: is("session-list") }]}><span class="avatar"><Icon name="ph:terminal-window" /></span><div><strong>Refactor API client</strong><small>12 {t.messages} · 10:42–11:08</small></div><button>{t.view}</button></div>
              <div class="session-card"><span class="avatar"><Icon name="ph:terminal-window" /></span><div><strong>Update documentation</strong><small>8 {t.messages} · 09:18–09:34</small></div><button>{t.view}</button></div>
            </>
          )}
        </div>
      )}

      {page === "usage" && (
        <div class="data-page">
          <div class:list={["filters", { target: is("usage-filter") }]}><button>{t.range}</button><button>Provider</button><button>Model</button></div>
          <div class="usage-sources"><strong>Sources</strong><span>Codex sessions · 11,813</span><span>Claude sessions · 12,566</span><span>Provider requests · 4</span><button>Sync sessions</button></div>
          <div class:list={["metrics", { target: is("usage-summary") }]}><span><small>{t.totalCost}</small><strong>$12.48</strong></span><span><small>{t.requests}</small><strong>248</strong></span><span><small>{t.tokens}</small><strong>1.2M</strong></span><span><small>{t.cache}</small><strong>68%</strong></span></div>
          {is("request-detail", "pricing", "pricing-save") ? (
