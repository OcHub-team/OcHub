---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import { DEFAULT_LOCALE, t, type Locale } from "@/lib/i18n";

interface Props extends HTMLAttributes<"div"> {
  markdownUrl?: string;
  lastUpdated?: Date;
  locale?: Locale;
}

const {
  markdownUrl,
  lastUpdated,
  class: className,
  locale = DEFAULT_LOCALE,
  ...attrs
} = Astro.props;

const baseBtn =
  "inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-transparent px-2 py-1 text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2";

// Copy-button states are applied from client JS, which has no access to
// the locale table — the three `data-label-*` attributes below hand it
// the strings it needs (read in page-actions.client.ts).
//
// Format the date in the page's own locale rather than the build
// machine's — `undefined` resolves to the system locale, which would
// render "Jan 5, 2026" on a Japanese page.
const formattedDate = lastUpdated
  ? new Intl.DateTimeFormat(locale.tag, { year: "numeric", month: "short", day: "numeric" }).format(lastUpdated)
  : null;
---

{(markdownUrl || lastUpdated) && (
  <div
    data-nb-page-actions
    data-md-url={markdownUrl}
    data-label-idle={t(locale, "copyPage")}
    data-label-copied={t(locale, "copied")}
    data-label-error={t(locale, "copyError")}
    class={cn("not-prose -ml-2 flex flex-wrap items-center gap-y-1 text-[0.8125rem]", className)}
    {...attrs}
  >
    {lastUpdated && (
      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
        <Icon name="ph:clock" class="w-3.5 h-3.5" />
        {t(locale, "updated")} <time datetime={lastUpdated.toISOString()}>{formattedDate}</time>
      </span>
    )}

    {markdownUrl && lastUpdated && (
      <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>
    )}

    {markdownUrl && (
      <>
        <button type="button" data-nb-page-actions-copy class={baseBtn}>
          <Icon name="ph:copy" class="w-3.5 h-3.5" data-nb-page-actions-copy-icon is:inline />
          <Icon name="ph:check" class="hidden w-3.5 h-3.5 text-success" data-nb-page-actions-check-icon is:inline />
          <span data-nb-page-actions-label aria-live="polite">{t(locale, "copyPage")}</span>
        </button>

        <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>

        <a
          href={markdownUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={baseBtn}
        >
          <Icon name="ph:markdown-logo" class="w-3.5 h-3.5" />
          {t(locale, "viewAsMarkdown")}
        </a>
      </>
    )}
  </div>
)}

<script>
  import "./page-actions.client";
</script>
