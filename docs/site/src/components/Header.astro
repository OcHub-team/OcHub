---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import { SearchTrigger } from "./ui/search";
import { config } from "virtual:nimbus/config";
import { getSidebarSections } from "@cloudflare/nimbus-docs";
import { DEFAULT_LOCALE, LOCALES, t, type Locale } from "@/lib/i18n";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  /** Locale this page belongs to, forwarded from DocsLayout. */
  locale?: Locale;
  /** `hreflang` alternates for this page, forwarded from DocsLayout. */
  alternates?: { tag: string; href: string }[];
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const {
  collection,
  showSidebar = true,
  locale = DEFAULT_LOCALE,
  alternates = [],
} = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const sections = await getSidebarSections(currentSlug, { collection });
const showSections = sections.length >= 2;

// Locale picker targets. Prefer this page's own translation; when a
// language hasn't translated this page yet, fall back to that language's
// home rather than linking to a 404.
const localeLinks = LOCALES.map((l) => {
  const alt = alternates.find((a) => a.tag === l.tag);
  return {
    ...l,
    href: alt?.href ?? `${l.prefix}/`,
    isTranslated: Boolean(alt),
    isCurrent: l.key === locale.key,
  };
});
---

<header class="sticky top-0 z-30 border-b border-border bg-header/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3">
      {/*
        Wordmark links to the current locale's home, not `/` — a reader
        browsing the Japanese docs shouldn't be dropped onto English.
        Two files rather than one: the mark is solid ink, so it needs an
        opposite-polarity version per theme. `-dark` is dark ink for light
        backgrounds, matching how the README uses them.
      */}
      <a href={`${locale.prefix}/`} class="group flex items-center" aria-label={config.title}>
        <img
          src="/ochub-wordmark-dark.png"
          alt={config.title}
          width="377"
          height="96"
          class="h-7 w-auto dark:hidden"
        />
        <img
          src="/ochub-wordmark-light.png"
          alt={config.title}
          width="377"
          height="96"
          class="hidden h-7 w-auto dark:block"
        />
      </a>

      {showSections && (
        <nav aria-label="Sections" class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6">
          {sections.map((section) => (
            <a
              href={section.href}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors",
                section.isActive
                  ? "text-foreground bg-accent"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2">
      {config.search !== false && <SearchTrigger locale={locale} />}

      {/*
        Locale picker. Native <details> so it works without JS — the rest
        of the header degrades gracefully too, and a docs site shouldn't
        need a hydration island to change language.
      */}
      <details class="relative group/locale">
        <summary
          class="flex items-center gap-1 h-8 px-2 rounded-md text-[0.8125rem] font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
          aria-label={t(locale, "language")}
        >
          <Icon name="ph:translate" class="w-4 h-4" />
          <span class="hidden sm:inline">{locale.label}</span>
          <Icon name="ph:caret-down" class="w-3 h-3 opacity-60 transition-transform group-open/locale:rotate-180" />
        </summary>

        <div class="absolute right-0 top-full mt-1 z-40 min-w-40 rounded-lg border border-border bg-card p-1 shadow-lg">
          {localeLinks.map((l) => (
            <a
              href={l.href}
              hreflang={l.tag}
              lang={l.tag}
              aria-current={l.isCurrent ? "true" : undefined}
              class:list={[
                "flex items-center justify-between gap-3 rounded-md px-2.5 py-1.5 text-[0.8125rem] no-underline transition-colors",
                l.isCurrent
                  ? "bg-sidebar-selected font-semibold text-foreground"
                  : "text-muted-foreground hover:bg-accent hover:text-foreground",
              ]}
            >
              <span>{l.label}</span>
              {!l.isTranslated && !l.isCurrent && (
                // This page has no translation in that language yet, so the
                // link goes to its home instead. Say so rather than letting
                // the reader discover it by landing somewhere unexpected.
                <Icon name="ph:arrow-u-down-left" class="w-3.5 h-3.5 opacity-50 shrink-0" />
              )}
            </a>
          ))}
        </div>
      </details>

      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label={t(locale, "openNavigation")}
          data-menu-btn
          class="lg:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>
